# ALTERADO: Exemplo de variáveis de ambiente obrigatórias do SCM.
SCM_DB_HOST=localhost
SCM_DB_NAME=scm_db
SCM_DB_USER=scm_user
SCM_DB_PASS=change_me

# ALTERADO: Endurecimento de autenticação/sessão.
# 1 = mantém fallback MD5 para migração; 0 = desativa fallback legado.
SCM_AUTH_ALLOW_LEGACY_MD5=1
# Tempo máximo de inatividade da sessão, em segundos.
SCM_SESSION_TIMEOUT=1800
# Tentativas de login antes de bloqueio temporário.
SCM_LOGIN_MAX_ATTEMPTS=5
# Duração do bloqueio em segundos após atingir limite.
SCM_LOGIN_LOCK_SECONDS=300
